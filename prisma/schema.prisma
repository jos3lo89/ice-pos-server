generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model sesiones_caja {
  id             String            @id @default(uuid())
  cajero_id      String
  saldo_apertura Decimal           @default(0) @db.Decimal(10, 2)
  saldo_esperado Decimal?          @default(0) @db.Decimal(10, 2)
  saldo_real     Decimal?          @default(0) @db.Decimal(10, 2)
  diferencia     Decimal?          @default(0) @db.Decimal(10, 2)
  estado         EstadoSesionCaja? @default(abierta)
  notas          String?
  fecha_apertura DateTime          @default(now())
  fecha_cierre   DateTime?

  usuarios           usuarios             @relation(fields: [cajero_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transacciones_caja transacciones_caja[]
  pagos              pagos[]
}

model transacciones_caja {
  id             String              @id @default(uuid())
  sesion_caja_id String?
  tipo           TipoTransaccionCaja
  monto          Decimal             @db.Decimal(10, 2)
  descripcion    String?
  fecha_creacion DateTime            @default(now())

  sesiones_caja sesiones_caja? @relation(fields: [sesion_caja_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model categorias {
  id                  String   @id @default(uuid())
  nombre              String   @db.VarChar(100)
  slug                String   @unique
  descripcion         String?
  esta_activa         Boolean  @default(true)
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  productos productos[]
}

model clientes {
  id                  String   @id @default(uuid())
  tipo_documento      String   @db.VarChar(1)
  numero_documento    String   @unique @db.VarChar(15)
  razon_social        String   @db.VarChar(255)
  direccion           String?
  ubigeo              String?  @db.VarChar(6)
  departamento        String?  @db.VarChar(50)
  provincia           String?  @db.VarChar(50)
  distrito            String?  @db.VarChar(50)
  correo              String?  @db.VarChar(100)
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  pagos pagos[]
}

model modificadores_item_orden {
  item_orden_id      String
  modificador_id     String
  nombre_modificador String  @db.VarChar(100)
  precio_adicional   Decimal @default(0) @db.Decimal(10, 2)

  modificadores_producto modificadores_producto @relation(fields: [modificador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items_orden            items_orden            @relation(fields: [item_orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([item_orden_id, modificador_id])
}

model items_orden {
  id              String  @id @default(uuid())
  orden_id        String
  producto_id     String
  variante_id     String?
  nombre_producto String  @db.VarChar(100)
  nombre_variante String? @db.VarChar(100)
  precio_variante Decimal @default(0) @db.Decimal(10, 2)
  cantidad        Int     @default(1)

  precio_unitario     Decimal @db.Decimal(10, 2) // Precio base sin variantes ni extras
  total_modificadores Decimal @default(0) @db.Decimal(10, 2) // Suma de los modificadores
  total_linea         Decimal @db.Decimal(10, 2) // Calculo final de esta línea

  estado EstadoOrden @default(pendiente)
  notas  String?

  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  modificadores_item_orden modificadores_item_orden[]
  ordenes                  ordenes                    @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productos                productos                  @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantes_producto       variantes_producto?        @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detalles_pago            detalles_pago[]

  @@index([orden_id], map: "idx_items_orden_orden")
  @@index([producto_id], map: "idx_items_orden_producto")
}

model ordenes {
  id                  String      @id @default(uuid())
  numero_orden        String      @unique @db.VarChar(20)
  mesa_id             String?
  mesero_id           String?
  estado              EstadoOrden @default(pendiente)
  tipo_orden          TipoOrden   @default(en_local)
  motivo_cancelacion  String?
  notas               String?
  total               Decimal?    @default(0) @db.Decimal(10, 2)
  monto_pagado        Decimal?    @default(0) @db.Decimal(10, 2)
  fecha_creacion      DateTime    @default(now())
  fecha_actualizacion DateTime    @updatedAt
  fecha_completado    DateTime?

  items_orden    items_orden[]
  usuarios       usuarios?     @relation(fields: [mesero_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pagos          pagos[]
  mesa_historial mesas?        @relation("RelacionHistorial", fields: [mesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mesa_actual    mesas?        @relation("RelacionActual")

  @@index([fecha_creacion], map: "idx_ordenes_fecha_creacion")
  @@index([estado], map: "idx_ordenes_estado")
  @@index([mesa_id], map: "idx_ordenes_mesa")
}

model detalles_pago {
  pago_id         String
  item_orden_id   String
  cantidad_pagada Int     @default(1)
  monto_pagado    Decimal @db.Decimal(10, 2)

  items_orden items_orden @relation(fields: [item_orden_id], references: [id], onUpdate: NoAction)
  pagos       pagos       @relation(fields: [pago_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([pago_id, item_orden_id])
}

model pagos {
  id                  String          @id @default(uuid())
  numero_pago         String          @unique @db.VarChar(20)
  orden_id            String
  cajero_id           String?
  cliente_id          String?
  sesion_caja_id      String?
  monto               Decimal         @default(0) @db.Decimal(10, 2)
  metodo              MetodoPago      @default(efectivo)
  tipo_documento      TipoDocumento   @default(ticket)
  estado              EstadoPago      @default(pendiente)
  id_externo          String?         @db.VarChar(100)
  notas               String?
  fecha_creacion      DateTime        @default(now())
  fecha_actualizacion DateTime        @updatedAt
  detalles_pago       detalles_pago[]
  usuarios            usuarios?       @relation(fields: [cajero_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sesiones_caja       sesiones_caja?  @relation(fields: [sesion_caja_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes            clientes?       @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordenes             ordenes         @relation(fields: [orden_id], references: [id], onUpdate: NoAction)

  @@index([sesion_caja_id], map: "idx_pagos_sesion_caja")
  @@index([orden_id], map: "idx_pagos_orden")
  @@index([estado], map: "idx_pagos_estado")
}

model modificadores_producto {
  id                 String  @id @default(uuid())
  producto_id        String
  nombre_modificador String  @db.VarChar(100)
  precio_adicional   Decimal @default(0) @db.Decimal(10, 2)
  esta_activo        Boolean @default(true)

  modificadores_item_orden modificadores_item_orden[]
  productos                productos                  @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([producto_id, nombre_modificador], map: "uq_modificador_producto")
}

model variantes_producto {
  id               String  @id @default(uuid())
  producto_id      String
  nombre_variante  String  @db.VarChar(100)
  precio_adicional Decimal @default(0) @db.Decimal(10, 2)
  esta_activa      Boolean @default(true)

  items_orden items_orden[]
  productos   productos     @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([producto_id, nombre_variante], map: "uq_variante_producto")
}

model productos {
  id                  String           @id @default(uuid())
  nombre              String           @db.VarChar(100)
  precio              Decimal          @db.Decimal(10, 2)
  categoria_id        String
  area_impresion      DestinoImpresion
  descripcion         String?
  esta_disponible     Boolean          @default(true)
  fecha_creacion      DateTime         @default(now())
  fecha_actualizacion DateTime         @updatedAt

  items_orden            items_orden[]
  modificadores_producto modificadores_producto[]
  variantes_producto     variantes_producto[]
  categorias             categorias?              @relation(fields: [categoria_id], references: [id], onUpdate: NoAction)

  @@unique([categoria_id, nombre], map: "uq_producto_nombre_cat")
  @@index([categoria_id], map: "idx_productos_categoria")
}

model configuraciones {
  id                  String   @id @default(uuid())
  clave               String   @unique @db.VarChar(100)
  valor               String?
  descripcion         String?
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
}

model pisos {
  id                  String   @id @default(uuid())
  nombre              String   @db.VarChar(50)
  nivel               Int      @unique
  esta_activo         Boolean  @default(true)
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  mesas mesas[]
}

model mesas {
  id                  String     @id @default(uuid())
  numero_mesa         String     @unique @db.VarChar(20)
  piso_id             String?
  estado              EstadoMesa @default(disponible)
  reservada_para      String?    @db.VarChar(100)
  orden_actual_id     String?    @unique
  fecha_creacion      DateTime   @default(now())
  fecha_actualizacion DateTime   @updatedAt

  pisos             pisos?    @relation(fields: [piso_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordenes_historial ordenes[] @relation("RelacionHistorial")
  orden_actual      ordenes?  @relation("RelacionActual", fields: [orden_actual_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado], map: "idx_mesas_estado")
  @@index([piso_id], map: "idx_mesas_piso")
}

model usuarios {
  id                  String     @id @default(uuid())
  usuario             String     @unique @db.VarChar(50)
  contrasena          String
  nombre_completo     String     @db.VarChar(100)
  rol                 RolUsuario @default(mesero)
  esta_activo         Boolean    @default(true)
  telefono            String     @unique @db.VarChar(9)
  fecha_creacion      DateTime   @default(now())
  fecha_actualizacion DateTime   @updatedAt

  sesiones_caja sesiones_caja[]
  ordenes       ordenes[]
  pagos         pagos[]

  @@index([rol], map: "idx_usuarios_rol")
}

enum EstadoSesionCaja {
  abierta
  cerrada
}

enum TipoTransaccionCaja {
  ingreso
  egreso
}

enum TipoDocumento {
  ticket
  boleta
  factura
}

enum EstadoOrden {
  pendiente
  preparando
  listo
  servido
  completado
  cancelado
}

enum TipoOrden {
  en_local
  para_llevar
}

enum MetodoPago {
  efectivo
  tarjeta
  yape
  plin
}

enum EstadoPago {
  pendiente
  pagado
  cancelado
}

enum DestinoImpresion {
  cocina
  bar
}

enum EstadoMesa {
  disponible
  ocupada
  reservada
  limpieza
}

enum RolUsuario {
  admin
  mesero
  cajero
  cocinero
  bartender
}
